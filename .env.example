# Sistema Inteligente de Gestión de Parqueos - variables de entorno
# Un solo archivo .env en la RAÍZ del repositorio; cada servicio lo carga
# por ruta fija desde su código (dotenv con path relativo al directorio raíz).

# Conexión a Supabase PostgreSQL (compartida por los tres microservicios;
# el certificado vive en certs/supabase-ca.crt de cada servicio)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require

# NO definir PORT en este archivo: cada servicio usa su puerto por defecto
#   api-gateway 3000 | parking-service 3001 | reservation-service 3002 | payment-service 3003

# Reservation Service (lo consulta el Payment Service para calcular importes)
RESERVATION_SERVICE_URL=http://localhost:3002
RESERVATION_SERVICE_TIMEOUT_MS=5000

# Vigencia de las cotizaciones del Payment Service, en minutos (por defecto 30)
QUOTE_TTL_MINUTES=30
