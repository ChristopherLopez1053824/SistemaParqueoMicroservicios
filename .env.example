# Copia este archivo como .env en la raíz o en el directorio del servicio que se ejecutará.
# No agregues credenciales reales al repositorio.

DATABASE_URL=postgresql://USUARIO:CONTRASENA@HOST:5432/postgres

# Token compartido entre API Gateway y servicios internos.
# Cámbialo por un valor aleatorio largo fuera del repositorio.
INTERNAL_API_TOKEN=cambia-este-token-interno

# Límite de tamaño de los cuerpos JSON aceptados por los servicios internos.
BODY_LIMIT=100kb

# Reservation Service
# PORT se define en reservation-service/.env o lo inyecta Compose (3002).
PARKING_SERVICE_URL=http://localhost:3001
PARKING_SERVICE_TIMEOUT_MS=3000
RECONCILIATION_WORKER_ENABLED=true
RECONCILIATION_POLL_INTERVAL_MS=2000
RECONCILIATION_LEASE_SECONDS=60
RECONCILIATION_RETRY_BASE_MS=1000
RECONCILIATION_RETRY_MAX_MS=60000
RECONCILIATION_MAX_ATTEMPTS=10

# Payment Service
RESERVATION_SERVICE_URL=http://localhost:3002
RESERVATION_SERVICE_TIMEOUT_MS=5000
QUOTE_TTL_MINUTES=30

# API Gateway
API_GATEWAY_PORT=3000
PARKING_SERVICE_URL=http://localhost:3001
RESERVATION_SERVICE_URL=http://localhost:3002
PAYMENT_SERVICE_URL=http://localhost:3003
CORS_ORIGINS=http://localhost:5173
PROXY_TIMEOUT_MS=10000
HEALTH_TIMEOUT_MS=2000

# Frontend
FRONTEND_PORT=5173
